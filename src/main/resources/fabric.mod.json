{
	"schemaVersion": 1,
	"id": "outflow",
	"version": "${version}",
	"name": "Outflow",
	"description": "A complete overhaul of Minecraft hydrology and terrain surfaces. Outflow unlocks lake generation at any altitude (breaking the hardcoded Y=63 limit) with smooth bathymetry, and includes a built-in fix for steep surface rules (MC-258859) to generate realistic stone cliffs instead of dirt stairs.",
	"authors": [
		"K8bus"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/outflow/icon.png",
	"environment": "*",
	"accessWidener": "outflow.accesswidener",
	"entrypoints": {
		"main": [
			"com.k8bus.outflow.Outflow"
		],
		"client": [
			"com.k8bus.outflow.client.OutflowClient"
		],
		"fabric-datagen": [
			"com.k8bus.outflow.client.OutflowDataGenerator"
		]
	},
	"mixins": [
		"outflow.mixins.json",
		{
			"config": "outflow.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
